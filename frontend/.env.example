# Server-only. Do not prefix this with NEXT_PUBLIC_ or expose it to browser code.
BACKEND_API_BASE_URL=https://api.example.com/api/v1

# Public because the browser connects to Django Channels directly. Use wss:// in production,
# or omit it when a reverse proxy exposes Channels at this frontend's host under /ws/chat/.
NEXT_PUBLIC_AI_WEBSOCKET_URL=ws://127.0.0.1:8000/ws/chat/
