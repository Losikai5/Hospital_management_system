DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=replace-with-at-least-50-random-characters
DEBUG=False
ALLOWED_HOSTS=api.example.com

DB_NAME=hospital_management
DB_USER=hospital_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=your-postgres-host
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
AUDIT_TRUST_X_FORWARDED_FOR=True

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
API_ANON_THROTTLE_RATE=120/min
API_USER_THROTTLE_RATE=1200/min

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-an-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Hospital System <no-reply@example.com>
STAFF_INVITATION_EXPIRY_HOURS=48

NOTIFICATIONS_ENABLED=True
CELERY_BROKER_URL=redis://your-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://your-redis-host:6379/1
APPOINTMENT_REMINDER_HOURS=24
APPOINTMENT_REMINDER_WINDOW_MINUTES=60

# Only required by the AI features that use Groq.
GROQ_API_KEY=replace-with-a-new-key